---
import { Image } from 'astro:assets';
import DemoWindow from './DemoWindow.astro';
import {
  banner,
  click,
  manifest,
  mark,
  markIndex,
  steps,
  story,
  strip,
  timing,
} from '../lib/demo-assets.ts';

// The HTML is the state the loop ends in: every line of the session, every
// frame on the timeline, and the frame with the Payment failed banner in the
// window. That is what shows without JavaScript and with reduced motion.
const shown = strip[banner.shown]!;
---

<figure class="demo" data-hero-demo data-timing={JSON.stringify(timing)}>
  <div class="scene" data-demo-scene>
    <div class="agent">
      <DemoWindow title="agent">
        <ol>
          {steps.map((step) =>
            step.kind === 'tool' ? (
              <li data-line class="tool">
                <code>{step.name}</code>
                <span class="args">{`(${step.args})`}</span>
                {step.result && (
                  <span class="result">{`→ ${step.result}`}</span>
                )}
              </li>
            ) : (
              <li data-line class={step.kind}>
                {step.text}
              </li>
            ),
          )}
        </ol>
      </DemoWindow>
    </div>
    <div class="browser">
      <DemoWindow title={story.title}>
        <Fragment slot="tools">
          <span class="badge" data-demo-badge>
            REC
          </span>
          <span class="timecode" data-demo-timecode>
            {shown.timecode}
          </span>
          <button
            type="button"
            class="pause"
            data-demo-pause
            hidden
            aria-pressed="false"
            aria-label="Pause the demo"
          ></button>
        </Fragment>
        <div class="stage">
          <img
            data-scrub-image
            src={shown.full}
            width={manifest.width}
            height={manifest.height}
            alt="The recorded checkout page at the selected frame"
            loading="eager"
            fetchpriority="high"
            decoding="async"
          />
          <div
            data-scrub-box
            hidden={!shown.boxAttr}
            style={shown.boxAttr || undefined}
          ></div>
          <span
            class="ring"
            style={`left: ${click.x}%; top: ${click.y}%`}
          ></span>
        </div>
      </DemoWindow>
      <div class="strip" data-scrub-strip>
        {strip.map((frame, i) => (
          <button
            type="button"
            aria-label={`Frame ${frame.label} at ${frame.timecode}`}
            aria-pressed={i === banner.shown ? 'true' : 'false'}
            tabindex={i === banner.shown ? 0 : -1}
            data-full={frame.full}
            data-label={frame.label}
            data-timecode={frame.timecode}
            data-changed={frame.changed}
            data-box={frame.boxAttr}
            data-keyframe={frame.keyframe ? '' : undefined}
          >
            <Image src={frame.image} width={160} alt="" loading="eager" />
            <span class="time">{frame.timecode}</span>
            {i === markIndex && <span class="mark">{mark.label}</span>}
          </button>
        ))}
      </div>
    </div>
  </div>
  <figcaption>
    Illustration of an MCP session. The frames are real recdr output.
  </figcaption>
</figure>

<script>
  import { initHeroDemo } from '../scripts/hero-demo.ts';

  initHeroDemo();
</script>

<style>
  /*
    hero-demo.ts plays the session in a loop and sets these on the figure:
      data-live       it is playing: lines and tiles without data-shown hide
      data-recording  the REC badge and the glow are on
      data-ring       the ring at the click runs once
    Without them the figure is in the state the loop ends in.
  */
  .demo {
    min-width: 0;
    margin: 0;
  }

  .scene {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-4);
  }

  /* On a phone the page that is recorded comes first, the log under it. */
  .agent {
    order: 1;
    min-width: 0;
  }

  .agent :global(.window) {
    height: 100%;
  }

  ol {
    display: grid;
    align-content: start;
    gap: var(--space-3);
    margin: 0;
    padding: var(--space-4);
    font-size: 0.8125rem;
    line-height: 1.5;
    list-style: none;
  }

  .tool {
    font-family: var(--font-mono);
    overflow-wrap: anywhere;
  }

  .tool code {
    color: var(--text);
  }

  .tool code::before {
    content: '';
    display: inline-block;
    width: 6px;
    height: 6px;
    margin-right: var(--space-2);
    border-radius: 50%;
    background: var(--text-muted);
    vertical-align: middle;
  }

  .args,
  .result,
  .action {
    color: var(--text-muted);
  }

  /* The arguments and the results need the width of the desktop panel. */
  .args,
  .result {
    display: none;
  }

  .finding {
    padding: var(--space-3) var(--space-4);
    border-left: 2px solid var(--rec);
    border-radius: 0 8px 8px 0;
    background: var(--surface-2);
    font-size: var(--text-sm);
  }

  .demo[data-live] [data-line] {
    transition:
      opacity 300ms ease-out,
      transform 300ms ease-out;
  }

  .demo[data-live] [data-line]:not([data-shown]) {
    visibility: hidden;
    opacity: 0;
    transform: translateY(0.25rem);
    transition: none;
  }

  .browser {
    position: relative;
    min-width: 0;
    isolation: isolate;
  }

  /* The glow while recording. A shadow, so it cannot make the page scroll sideways. */
  .browser::before {
    content: '';
    position: absolute;
    inset: 0 0 4rem;
    z-index: -1;
    border-radius: var(--radius);
    box-shadow: 0 0 7rem 0.5rem rgb(229 72 77 / 0.3);
    opacity: 0;
    transition: opacity 600ms;
    pointer-events: none;
  }

  .demo[data-recording] .browser::before {
    opacity: 1;
  }

  .badge {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    visibility: hidden;
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.04em;
  }

  .badge::before {
    content: '';
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--rec);
  }

  .demo[data-recording] .badge {
    visibility: visible;
  }

  .demo[data-recording] .badge::before {
    animation: blink 1s steps(2, jump-none) infinite;
  }

  .timecode {
    color: var(--text-muted);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-variant-numeric: tabular-nums;
  }

  .pause {
    display: grid;
    place-items: center;
    width: 1.75rem;
    height: 1.75rem;
    padding: 0;
    border: 1px solid var(--border);
    border-radius: 6px;
    background: var(--surface);
    color: var(--text);
    cursor: pointer;
  }

  .pause[hidden] {
    display: none;
  }

  /* Two bars while it plays, a triangle while it is paused. */
  .pause::before {
    content: '';
    width: 3px;
    height: 10px;
    border-inline: 3px solid currentColor;
  }

  .pause[aria-pressed='true']::before {
    width: 0;
    height: 0;
    border-width: 5px 0 5px 9px;
    border-style: solid;
    border-color: transparent transparent transparent currentColor;
  }

  .stage {
    position: relative;
    overflow: hidden;
  }

  .stage img {
    display: block;
    width: 100%;
    height: auto;
  }

  [data-scrub-box] {
    position: absolute;
    border: 2px solid var(--rec);
    border-radius: 4px;
    pointer-events: none;
  }

  .ring {
    position: absolute;
    width: 2.5rem;
    height: 2.5rem;
    margin: -1.25rem 0 0 -1.25rem;
    border: 2px solid var(--rec);
    border-radius: 50%;
    opacity: 0;
    pointer-events: none;
  }

  .demo[data-ring] .ring {
    animation: ring 400ms ease-out;
  }

  /* position: the script reads a tile's offset from the strip. */
  .strip {
    position: relative;
    display: flex;
    gap: var(--space-2);
    overflow-x: auto;
    /* room above for the mark's label */
    padding: var(--space-4) var(--space-1) var(--space-2);
    scrollbar-color: var(--border) transparent;
    scrollbar-width: thin;
  }

  .strip button {
    position: relative;
    flex: none;
    width: 6rem;
    padding: 0;
    border: 1px solid var(--border);
    border-radius: 8px;
    background: var(--surface);
    color: var(--text-muted);
    font: inherit;
    cursor: pointer;
  }

  .strip button[aria-pressed='true'] {
    border-color: var(--rec);
    color: var(--text);
  }

  .demo[data-live] .strip button:not([data-shown]) {
    display: none;
  }

  .strip :global(img) {
    display: block;
    width: 100%;
    height: auto;
    border-radius: 7px 7px 0 0;
  }

  .time {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-1);
    padding-block: 2px;
    font-family: var(--font-mono);
    font-size: 0.625rem;
    font-variant-numeric: tabular-nums;
  }

  .strip button[data-keyframe] .time::before {
    content: '';
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: var(--rec);
  }

  /* The label of `recdr mark`, on the first frame after it. */
  .mark {
    position: absolute;
    top: -0.625rem;
    left: 0.25rem;
    padding: 0 0.375rem;
    border: 1px solid var(--rec);
    border-radius: 999px;
    background: var(--bg);
    color: var(--text);
    font-family: var(--font-mono);
    font-size: 0.625rem;
    line-height: 1.5;
    white-space: nowrap;
  }

  figcaption {
    margin-top: var(--space-3);
    color: var(--text-muted);
    font-size: var(--text-sm);
  }

  @keyframes blink {
    from {
      opacity: 1;
    }

    to {
      opacity: 0.25;
    }
  }

  @keyframes ring {
    from {
      opacity: 1;
      transform: scale(0.3);
    }

    to {
      opacity: 0;
      transform: scale(1);
    }
  }

  @media (min-width: 64rem) {
    .scene {
      grid-template-columns: minmax(0, 22rem) minmax(0, 1fr);
      gap: var(--space-6);
    }

    .agent {
      order: 0;
    }

    .args {
      display: inline;
    }

    .result {
      display: block;
    }
  }

  /* hero-demo.ts sets --rx and --ry from the pointer's place over the demo. */
  @media (hover: hover) and (pointer: fine) and (prefers-reduced-motion: no-preference) {
    .scene {
      transform: perspective(1400px) rotateX(var(--rx, 0deg))
        rotateY(var(--ry, 0deg));
      transition: transform 200ms ease-out;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .demo :global(*),
    .browser::before {
      transition: none;
      animation: none;
    }
  }
</style>
