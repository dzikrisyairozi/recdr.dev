---
import { installCommands } from '../lib/install.ts';

interface Props {
  // The landing page has two of these, and element ids must be unique.
  idPrefix: string;
}

const { idPrefix } = Astro.props;
---

<div class="install-command" data-install>
  <div class="tabs" role="tablist" aria-label="Install method">
    {installCommands.map((command) => (
      <button
        type="button"
        role="tab"
        data-tab={command.id}
        id={`${idPrefix}-tab-${command.id}`}
        aria-controls={`${idPrefix}-panel-${command.id}`}
      >
        {command.label}
      </button>
    ))}
  </div>
  <div class="body">
    <div class="panels">
      {installCommands.map((command) => (
        <div
          class="panel"
          role="tabpanel"
          data-panel={command.id}
          id={`${idPrefix}-panel-${command.id}`}
          aria-labelledby={`${idPrefix}-tab-${command.id}`}
        >
          <span class="panel-label">{command.label}</span>
          <pre tabindex="0"><code>{command.text}</code></pre>
        </div>
      ))}
    </div>
    <button type="button" class="copy" data-copy>
      Copy
    </button>
  </div>
  <span class="visually-hidden" aria-live="polite" data-copy-status></span>
</div>

<script>
  import { tabForPlatform } from '../lib/install.ts';
  import { initInstallTabs } from '../scripts/install-tabs.ts';

  initInstallTabs(tabForPlatform(navigator.platform));
</script>

<style>
  .install-command {
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--surface);
    text-align: left;
  }

  /* Without JavaScript every command shows, each under its label. */
  .tabs,
  .copy {
    display: none;
  }

  .panel {
    padding: var(--space-3) var(--space-4);
  }

  .panel-label {
    color: var(--text-muted);
    font-size: var(--text-sm);
  }

  pre {
    margin: 0;
    overflow-x: auto;
    font-size: var(--text-sm);
    line-height: 2;
  }

  [data-enhanced] .tabs {
    display: flex;
    gap: var(--space-1);
    padding-inline: var(--space-2);
    border-bottom: 1px solid var(--border);
  }

  [data-enhanced] .panel-label {
    display: none;
  }

  [data-enhanced] .body {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    padding-inline-end: var(--space-2);
  }

  [data-enhanced] .panels {
    flex: 1;
    min-width: 0;
  }

  [role='tab'] {
    padding: var(--space-3);
    border: 0;
    border-bottom: 2px solid transparent;
    background: none;
    color: var(--text-muted);
    font: inherit;
    font-size: var(--text-sm);
    cursor: pointer;
  }

  [role='tab'][aria-selected='true'] {
    border-bottom-color: var(--rec);
    color: var(--text);
  }

  [data-enhanced] .copy {
    display: block;
    min-width: 4.5rem;
    padding: var(--space-2) var(--space-3);
    border: 1px solid var(--border);
    border-radius: 999px;
    background: var(--surface-2);
    color: var(--text);
    font: inherit;
    font-size: var(--text-sm);
    cursor: pointer;
  }
</style>
