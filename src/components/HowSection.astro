---
const beats = [
  {
    title: 'Record',
    command: 'recdr start --cdp 9222 --tab checkout',
    text: 'Start a background recording. recdr returns its id at once.',
  },
  {
    title: 'Stop',
    command: 'recdr stop <id>',
    text: 'Stop it, encode, and get the result as JSON.',
  },
  {
    title: 'Read',
    command: null,
    text: 'The agent opens contact_sheet.png, diff.json and the frames.',
  },
];
---

<section id="how" class="section" data-scene="how">
  <div data-pin>
    <h2 class="section-title" data-reveal>
      Record, stop, read
    </h2>
    <div class="track">
      <div class="progress" data-how-progress></div>
    </div>
    <ol>
      {beats.map((beat, i) => (
        <li data-beat>
          <span class="number">0{i + 1}</span>
          <h3>{beat.title}</h3>
          {beat.command && <pre tabindex="0"><code>{beat.command}</code></pre>}
          <p>{beat.text}</p>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  /* One screen tall with the steps in the middle, so the pinned scene
     does not leave the lower half of the screen empty. */
  [data-pin] {
    display: grid;
    align-content: center;
    min-height: calc(100svh - 2 * var(--space-24));
  }

  .track {
    height: 2px;
    margin-bottom: var(--space-8);
    background: var(--border);
  }

  /* Full without JavaScript. The pinned scene scales it from 0 to 1. */
  .progress {
    height: 100%;
    background: var(--rec);
    transform-origin: left;
  }

  ol {
    display: grid;
    gap: var(--space-8);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  li {
    min-width: 0;
  }

  .number {
    color: var(--rec);
    font-family: var(--font-mono);
    font-size: var(--text-sm);
  }

  h3 {
    margin: var(--space-2) 0 var(--space-4);
    font-size: var(--text-xl);
    font-weight: 600;
    letter-spacing: -0.02em;
  }

  pre {
    margin: 0 0 var(--space-4);
    padding: var(--space-3) var(--space-4);
    overflow-x: auto;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--surface);
    font-size: var(--text-sm);
  }

  p {
    margin: 0;
    color: var(--text-muted);
  }

  @media (min-width: 48rem) {
    ol {
      grid-template-columns: repeat(3, 1fr);
    }
  }
</style>
