<style>
  section {
    max-width: 44rem;
    margin-inline: auto;
    padding: var(--space-24) var(--space-4);
  }

  h1 {
    margin: 0 0 var(--space-6);
    font-size: var(--text-3xl);
    font-weight: 600;
    letter-spacing: -0.02em;
  }
</style>
