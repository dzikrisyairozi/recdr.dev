---
import Site from '../layouts/Site.astro';
import { fetchReleases, REPO } from '../lib/github.ts';

const releases = await fetchReleases(fetch, process.env.GITHUB_TOKEN);
// Cloudflare Pages sets CF_PAGES_BRANCH. On the production branch a build
// that could not read the releases fails, and Pages keeps the deployment
// before it online. A preview or local build shows a link to GitHub instead.
if (releases === null && process.env.CF_PAGES_BRANCH === 'main') {
  throw new Error(
    'The releases could not be read from GitHub (see the [github] warning above). If the API limit was hit, set GITHUB_TOKEN in the Pages project.',
  );
}
const releasesUrl = `https://github.com/${REPO}/releases`;
---

<Site
  title="Changelog"
  description="Every recdr release and what changed in it."
>
  <section class="page">
    <h1 class="page-title">Changelog</h1>
    {releases === null ? (
      <p>
        Release notes are <a href={releasesUrl}>on GitHub</a>.
      </p>
    ) : releases.length === 0 ? (
      <p>
        No releases yet. Watch <a href={releasesUrl}>the releases page</a>.
      </p>
    ) : (
      releases.map((release) => (
        <article id={release.tag}>
          <header>
            <h2>
              <a href={release.url}>{release.tag}</a>
            </h2>
            <time datetime={release.date}>{release.date.slice(0, 10)}</time>{' '}
            {release.prerelease && <span class="pre">Pre-release</span>}
          </header>
          <div class="prose" set:html={release.html} />
        </article>
      ))
    )}
  </section>
</Site>

<style>
  article {
    padding-block: var(--space-8);
    border-top: 1px solid var(--border);
  }

  header {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--space-2) var(--space-4);
    margin-bottom: var(--space-4);
  }

  h2 {
    margin: 0;
    font-family: var(--font-mono);
    font-size: var(--text-xl);
    font-weight: 600;
  }

  h2 a {
    color: var(--text);
    text-decoration: none;
  }

  h2 a:hover {
    color: var(--rec);
  }

  time,
  .pre {
    color: var(--text-muted);
    font-size: var(--text-sm);
  }

  .pre {
    padding: 0 var(--space-2);
    border: 1px solid var(--border);
    border-radius: 999px;
  }
</style>
