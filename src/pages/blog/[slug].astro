---
import type { GetStaticPaths } from 'astro';
import { getCollection, render } from 'astro:content';
import Site from '../../layouts/Site.astro';
import { publishedPosts } from '../../lib/blog.ts';
import { cardUrl } from '../../lib/og.ts';

export const getStaticPaths = (async () => {
  const posts = publishedPosts(await getCollection('blog'));
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}) satisfies GetStaticPaths;

const { post } = Astro.props;
const { Content } = await render(post);

const published = post.data.date.toISOString().slice(0, 10);
// The site has no bylines, so the project is the author.
const recdr = { '@type': 'Organization', name: 'recdr', url: Astro.site };
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: post.data.title,
  description: post.data.description,
  datePublished: published,
  image: cardUrl(Astro.url.pathname, Astro.site),
  url: new URL(Astro.url.pathname, Astro.site),
  author: recdr,
  publisher: recdr,
};
---

<Site
  title={post.data.title}
  description={post.data.description}
  jsonLd={jsonLd}
  published={published}
>
  <article class="page">
    <time datetime={published}>{published}</time>
    <h1 class="page-title">{post.data.title}</h1>
    <div class="prose">
      <Content />
    </div>
    <p class="back">
      <a href="/blog/">All posts</a>
    </p>
  </article>
</Site>

<style>
  .page-title {
    margin-top: var(--space-2);
  }

  .back {
    margin: var(--space-12) 0 0;
  }
</style>
