---
import AgentsSection from '../components/AgentsSection.astro';
import ClickRings from '../components/ClickRings.astro';
import DemoSection from '../components/DemoSection.astro';
import Faq from '../components/Faq.astro';
import FilesSection from '../components/FilesSection.astro';
import FrameScrubber from '../components/FrameScrubber.astro';
import Hero from '../components/Hero.astro';
import HowSection from '../components/HowSection.astro';
import InstallSection from '../components/InstallSection.astro';
import PlatformMatrix from '../components/PlatformMatrix.astro';
import WhySection from '../components/WhySection.astro';
import Site from '../layouts/Site.astro';
import { REPO } from '../lib/github.ts';
import { plainText, questions } from '../lib/landing.ts';

const description =
  'recdr records a window, a screen region, a monitor or a Chrome tab and leaves files an AI agent can read. Agents drive it through a JSON CLI or an MCP server.';

// What a search engine or an answer engine reads about recdr and the FAQ.
// The values are the README's: the systems it runs on, the MIT license, no price.
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'SoftwareApplication',
      name: 'recdr',
      description,
      url: Astro.site,
      applicationCategory: 'DeveloperApplication',
      operatingSystem: 'Windows, macOS, Linux',
      license: 'https://opensource.org/license/mit',
      downloadUrl: `https://github.com/${REPO}/releases`,
      sameAs: `https://github.com/${REPO}`,
      offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
    },
    {
      '@type': 'FAQPage',
      mainEntity: questions.map(({ question, answer }) => ({
        '@type': 'Question',
        name: question,
        acceptedAnswer: { '@type': 'Answer', text: plainText(answer) },
      })),
    },
  ],
};
---

<Site
  title="recdr: screen recorder your agent can use"
  description={description}
  jsonLd={jsonLd}
>
  <Hero />
  <DemoSection />
  <WhySection />
  <HowSection />
  <FrameScrubber />
  <FilesSection />
  <AgentsSection />
  <PlatformMatrix />
  <Faq />
  <InstallSection />
  <ClickRings />
</Site>

<script>
  import { prefersReducedMotion } from '../scripts/motion.ts';
  import { initReveals } from '../scripts/reveal.ts';

  initReveals();

  // GSAP only drives sections below the hero, so it is fetched after the
  // load event and the headline and install command render without it.
  if (!prefersReducedMotion()) {
    window.addEventListener(
      'load',
      async () => {
        const { initScrollScenes } =
          await import('../scripts/scroll-scenes.ts');
        initScrollScenes();
      },
      { once: true },
    );
  }
</script>
